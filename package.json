{
  "name": "poland-internship-hunter",
  "version": "1.0.0",
  "description": "Poland Internship Hunter & Email Automation - Windows Desktop Application",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"node wait-and-electron.cjs\"",
    "build:renderer": "tsc && vite build",
    "build": "npm run build:renderer && electron-builder --win --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "nodemailer": "^10.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.antigravity.polandinternshiphunter",
    "productName": "Poland Internship Hunter",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
